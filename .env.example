TYPESAFE_API_KEY=replace-with-your-typesafe-key
JEV_MODEL=jev-latest
GROQ_MODEL=openai/gpt-oss-20b
# Writes the replies built on plugin data (GitHub); the 20b model invented details there.
GROQ_TOOL_MODEL=openai/gpt-oss-120b
# Jev's voice: the visitor's Google key comes from Ajustes; these only choose the model and the voice. Server only.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Puck
# GitHub plugin: optional fine-grained token with read-only access to public repositories. Without it GitHub
# allows 60 lookups per hour for the whole server. Server only.
GITHUB_TOKEN=replace-with-a-read-only-github-token
# UATF enrollments: project URL and secret key (sb_secret_…) from Supabase › Project Settings › API Keys. Server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
