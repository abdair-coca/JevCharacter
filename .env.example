TYPESAFE_API_KEY=replace-with-your-typesafe-key
JEV_MODEL=jev-latest
GROQ_MODEL=openai/gpt-oss-20b
# Jev's voice: the visitor's Google key comes from Ajustes; these only choose the model and the voice. Server only.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Puck
# UATF enrollments: project URL and secret key (sb_secret_…) from Supabase › Project Settings › API Keys. Server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
